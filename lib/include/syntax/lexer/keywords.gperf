%{
#include <string.h>
#include "tokens.h"
%}

%struct-type
struct Keyword {
  const char *name;
  int token_kind;
};

%%
extrn,    TOK_EXTRN
auto,     TOK_AUTO
if,       TOK_IF
else,     TOK_ELSE
while,    TOK_WHILE
break,    TOK_BREAK
continue, TOK_CONTINUE
switch,   TOK_SWITCH
case,     TOK_CASE
goto,     TOK_GOTO
return,   TOK_RETURN
%%
